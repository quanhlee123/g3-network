# =====================================================================
# G3 Network — biến môi trường local (Phase 1, simulator)
# Copy file này thành infra/.env (npm install tự làm nếu chưa có).
# KHÔNG commit infra/.env. Giá trị dưới đây là MẪU cho máy local,
# không phải secret thật — đổi mật khẩu trước khi dùng chung.
# =====================================================================

# --- PostgreSQL (TimescaleDB + PostGIS, container g3-db) ---
POSTGRES_USER=g3
POSTGRES_PASSWORD=g3_local_doi_mat_khau
POSTGRES_DB=g3
DATABASE_URL=postgres://g3:g3_local_doi_mat_khau@localhost:5432/g3
# Số tháng giữ dữ liệu telematics "hot" trong TimescaleDB (NF-16, mặc định 12).
# Áp dụng khi chạy `npm run db:migrate`.
TELEMETRY_RETENTION_MONTHS=12

# --- MQTT (EMQX, container g3-emqx) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_URL=mqtt://localhost:1883
# Mật khẩu đăng nhập dashboard EMQX (http://localhost:18083, user: admin)
EMQX_DASHBOARD__DEFAULT_PASSWORD=g3_local_doi_mat_khau

# --- Ứng dụng ---
API_PORT=3000
PORTAL_PORT=3100

# --- Xác thực API (F-F1) ---
# Khóa ký JWT. ĐỂ TRỐNG Ở ĐÂY (quy tắc 3 — không commit giá trị thật):
# `npm install` chạy scripts/setup-env.mjs sinh khóa ngẫu nhiên vào infra/.env.
JWT_SECRET=
# Hạn dùng access token (cú pháp @fastify/jwt: 15m, 12h, 7d…)
JWT_EXPIRES_IN=12h
# OTP đăng nhập: hạn dùng (giây) và số lần nhập sai tối đa cho mỗi mã
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Chống dò mã: số lần XIN mã tối đa cho 1 SĐT trong khung thời gian (giây).
# OTP_MAX_ATTEMPTS một mình không đủ — không chặn việc xin mã mới thì kẻ tấn công
# cứ xin mã để có thêm lượt đoán (10^6 tổ hợp / 5 lượt ≈ 5,5 giờ là dò xong).
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_S=900
# Trần số bản ghi 1 lần gọi GET /vehicles/{id}/telemetry/history
TELEMETRY_HISTORY_MAX_ROWS=1000

# --- Chính sách sạc bảo hành (F-B1) ---
# Múi giờ IANA để hiểu khung giờ ToU trong chính sách. Khung giờ ghi trong hợp đồng bảo hành
# là giờ Việt Nam, còn timestamptz trong DB là UTC — sai chỗ này lệch đúng 7 tiếng và hệ thống
# gắn cờ vi phạm oan gần như toàn bộ phiên sạc đêm. Xem docs/adr/ADR-010.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- Gắn cờ vi phạm sạc (F-B3, F-B5) ---
# Chu kỳ job đối chiếu phiên sạc với chính sách (ms). 0 = tắt, chỉ chạy tay qua POST /violations/run.
VIOLATION_SCAN_INTERVAL_MS=300000
# Tiêu chí "THƯỜNG XUYÊN" của F-B3 ("thường xuyên >90% hoặc <20%"): bao nhiêu lần chạm ngưỡng
# SOC trong bao nhiêu ngày thì kết luận vi phạm. Chính sách nào tự khai soc_breach_count /
# soc_breach_window_days thì theo hợp đồng đó, không thì theo hai giá trị dưới đây.
# ⚠️ HAI CON SỐ NÀY CHƯA ĐƯỢC BẢO HÀNH MOBILITY / NHÀ SẢN XUẤT PIN / LEGAL KÝ — xem
# docs/adr/ADR-011 và Q4 (MỞ). Tới khi có người ký, kết luận soc_above_max/soc_below_min chỉ
# nên dùng để nhắc tài xế, KHÔNG dùng làm căn cứ từ chối bảo hành.
VIOLATION_SOC_BREACH_COUNT=3
VIOLATION_SOC_BREACH_WINDOW_DAYS=30

# --- Đối soát 3 chiều (F-C6, NF-10) ---
# Chu kỳ chạy job đối soát trong tiến trình API (ms). 0 = tắt, chỉ chạy tay.
RECONCILE_INTERVAL_MS=300000
# Ngưỡng NF-10: lệch kWh lớn hơn mức này (%) thì sinh cảnh báo
RECONCILE_NGUONG_PCT=1
# Hiệu suất sạc lưới → pin (0.1–1.0). Phase 1 để 1.0 vì simulator sinh dữ liệu lý tưởng.
# BẮT BUỘC hiệu chuẩn bằng dữ liệu pilot trước Gate 1 — xem docs/adr/ADR-007.
CHARGE_EFFICIENCY=1.0
# Đơn giá điện GIẢ để quy số tiền về kWh (VNĐ/kWh, NF-17)
CHARGING_PRICE_VND_PER_KWH=3500
# Bản ghi telemetry xa mốc phiên sạc quá số giây này thì coi như thiếu dữ liệu
RECONCILE_SOC_WINDOW_S=60
# Cổng WebSocket cho CSMS (OCPP 1.6J) — dùng từ Prompt 05
CSMS_WS_PORT=9220
# Cổng HTTP nội bộ của CSMS: RemoteStart/RemoteStop (chuẩn bị luồng thanh toán QR F-H1)
CSMS_HTTP_PORT=9221
# Cổng HTTP /metrics của service ingest (Prometheus — NF-01/NF-14)
INGEST_METRICS_PORT=9464

# --- Thông báo đa kênh (F-F3) ---
# Chống spam (sheet 2, bước 5 hành trình tài xế): tối đa bao nhiêu tin ĐÃ GỬI cho mỗi
# (người nhận × loại alert × kênh) trong một cửa sổ bao nhiêu giây.
# CHỈ áp cho kênh chen ngang (push, SMS) — kênh in-app không bao giờ bị chặn, và cảnh báo
# nguy cấp (severity 3: pin ≤10%, bất thường pin, tamper) cũng không bao giờ bị chặn.
# Xem docs/adr/ADR-008-rate-limit-thong-bao.md
NOTIFY_RATE_LIMIT_MAX=3
NOTIFY_RATE_LIMIT_WINDOW_S=900

# --- Thanh toán phiên sạc (F-H1) — SANDBOX ONLY ---
# Cổng đang bật: mock (mặc định, chạy hoàn toàn trong tiến trình) hoặc vnpay (SANDBOX).
# Để "mock" thì máy sạch chạy được toàn bộ luồng mà không cần tài khoản cổng nào.
PAYMENT_GATEWAY=mock
# URL app quay về sau khi trả tiền xong (để trống = dùng mặc định của từng cổng)
PAYMENT_RETURN_URL=
# Chu kỳ job nối giao dịch đã thu tiền với phiên sạc VỀ MUỘN (ms). 0 = tắt.
# Cần job này vì webhook có thể đến TRƯỚC khi trụ kịp gửi StopTransaction (NF-09).
PAYMENT_LINK_INTERVAL_MS=120000
# Gốc HTTP nội bộ của CSMS để gửi RemoteStart (mặc định suy ra từ CSMS_HTTP_PORT)
CSMS_INTERNAL_URL=

# --- VNPay SANDBOX (chỉ dùng khi PAYMENT_GATEWAY=vnpay) ---
# ⚠️ ĐỂ TRỐNG TRONG FILE MẪU NÀY (quy tắc 3 — không commit giá trị thật).
# Tự đăng ký tài khoản sandbox tại https://sandbox.vnpayment.vn và điền vào infra/.env.
# infra/.env KHÔNG được commit.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# BẮT BUỘC là host sandbox. @g3/payments TỪ CHỐI KHỞI ĐỘNG nếu URL không chứa "sandbox"
# — rào chắn nằm trong mã, không phải lời nhắc (xem docs/adr/ADR-012).
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payments/ket-qua
# Số phút link thanh toán còn hiệu lực
VNPAY_EXPIRE_MINUTES=15

# --- SOS & SLA ticket (F-I2) ---
# Chu kỳ quét ticket quá hạn chưa ai nhận (ms). SLA của SOS là 5 phút nên quét thưa hơn
# thì cảnh báo leo thang đến muộn tới mức vô nghĩa. 0 = tắt.
SLA_SCAN_INTERVAL_MS=60000

# --- Sức khỏe & tamper thiết bị (F-J1, F-J3) ---
# Chu kỳ job quét thiết bị im lặng trong tiến trình API (ms). 0 = tắt.
DEVICE_SCAN_INTERVAL_MS=600000
# Thiết bị im lặng quá số GIỜ này thì sinh cảnh báo (F-J1: "xe im lặng > X giờ")
DEVICE_SILENCE_HOURS=6
# Điện áp NGUỒN NUÔI thiết bị (V) dưới mức này là đang yếu/sắp hết → kết luận "hết nguồn"
# chứ không phải bị tháo. Khác battery_voltage_v (điện áp pack kéo xe, 320–690V).
DEVICE_SUPPLY_VOLTAGE_LOW_V=11
# Cường độ sóng (dBm, LUÔN ÂM) yếu hơn mức này thì coi là đang mất sóng dần → không phải tamper
DEVICE_SIGNAL_WEAK_DBM=-95

# --- Portal đội xe Next.js (F-E1) ---
# Địa chỉ apps/api mà MÁY CHỦ portal gọi tới. Khác app tài xế: biến này KHÔNG có tiền tố
# NEXT_PUBLIC_ nên không bị nhúng vào mã tải về trình duyệt — mọi lời gọi API xuất phát từ
# máy chủ Next.js, và token đăng nhập nằm trong cookie httpOnly (trình duyệt không đọc được).
# Bỏ trống = http://localhost:<API_PORT>.
G3_API_URL=
# Hạn chờ tối đa cho 1 lần portal gọi apps/api (ms).
G3_API_TIMEOUT_MS=8000

# --- App tài xế Expo (F-D4) ---
# ⚠️ Biến EXPO_PUBLIC_* được NHÚNG THẲNG vào bundle tải về máy — ai giải nén APK cũng
# đọc được. Chỉ đặt giá trị công khai được ở đây. KHÔNG đặt secret (khoá JWT, khoá cổng
# thanh toán) — những thứ đó ở lại apps/api.
#
# Địa chỉ apps/api mà app gọi tới. Bỏ trống thì app dùng http://10.0.2.2:3000 — lối tắt
# của TRÌNH GIẢ LẬP Android trỏ về localhost máy chủ. Chạy trên ĐIỆN THOẠI THẬT qua
# Expo Go thì địa chỉ đó không tồn tại: phải điền IP LAN của máy chạy apps/api,
# vd http://192.168.1.50:3000 (xem `ipconfig` / `ifconfig`).
EXPO_PUBLIC_API_URL=
# Hạn chờ tối đa cho 1 lần gọi API (ms). Để rộng tay vì tài xế chạy tuyến hay vào vùng
# sóng yếu; quá ngắn thì app báo "mạng chậm" oan khi mạng chỉ hơi lag.
EXPO_PUBLIC_API_TIMEOUT_MS=10000
