{
  "openapi": "3.0.3",
  "info": {
    "title": "G3 Network API",
    "description": "API nền tảng vận hành xe tải điện — Phase 1 (simulator, dữ liệu giả 100%).",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Kiểm tra sức khỏe hệ thống",
        "tags": [
          "he-thong"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "uptime_s",
                    "telemetry_schema_version",
                    "timestamp"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "uptime_s": {
                      "type": "number"
                    },
                    "telemetry_schema_version": {
                      "type": "number"
                    },
                    "timestamp": {
                      "format": "date-time",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
